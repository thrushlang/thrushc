directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

fn deepClass(row: s32, col: s32, seed: s32) s32 @public {
    var result: s32 = 0;

    if row == 0 {
        if col == 0 {
            result = 1;
        } else if col == 1 {
            result = 2;
        } else {
            result = 3;
        }
    } else if row == 1 {
        if seed > 5 {
            if col == 0 {
                result = 4;
            } else {
                result = 5;
            }
        } else {
            result = 6;
        }
    } else {
        if col < row {
            result = 7;
        } else if col == row {
            result = 8;
        } else {
            result = 9;
        }
    }

    return result;
}

fn nestedWhileGrid(limit: s32) s32 @public {
    var row: s32 = 0;
    var total: s32 = 0;

    while row < limit {
        var col: s32 = 0;

        while col < 3 {
            total = total + deepClass(row, col, 7);
            col = col + 1;
        }

        row = row + 1;
    }

    if total == 42 {
        total = total + 10;
    } else {
        total = total + 100;
    }

    return total;
}

fn whileVarInline(limit: s32) s32 @public {
    var total: s32 = 0;

    while var i: s32 = 0; i < limit; {
        if i == 0 {
            total = total + 2;
        } else if i == 1 {
            total = total + 4;
        } else {
            total = total + 8;
        }

        i++;
    }

    return total;
}

fn main() s32 @public {
    var total: s32 = 0;

    total = total + deepClass(0, 0, 7);
    total = total + deepClass(0, 2, 7);
    total = total + deepClass(1, 0, 7);
    total = total + deepClass(1, 2, 7);
    total = total + deepClass(2, 1, 7);
    total = total + deepClass(2, 2, 7);
    total = total + nestedWhileGrid(3);
    total = total + whileVarInline(4);

    if total != 102 {
        return total;
    }

    return 0;
}
