directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

fn beforeAfter(seed: s32) s32 @public {
    var result: s32 = 0;

    if seed < 0 {
        result = 100;
    } else if seed == 0 {
        result = 10;
    } else {
        result = 20;
    }

    for var i: s32 = 0; i < 4; i++; {
        if result == 20 {
            if i == 0 {
                result = result + 1;
            } else if i == 1 {
                result = result + 3;
            } else {
                result = result + 5;
            }
        } else {
            if i == 2 {
                result = result + 2;
            } else {
                result = result + 1;
            }
        }
    }

    if result > 30 {
        result = result + 7;
    } else if result == 24 {
        result = result + 11;
    } else {
        result = result + 13;
    }

    return result;
}

fn main() s32 @public {
    var total: s32 = 0;

    total = total + beforeAfter(1);
    total = total + beforeAfter(0);
    total = total + beforeAfter(-1);

    if total != 178 {
        return total;
    }

    return 0;
}
